{
  "name": "cleevoice",
  "version": "0.1.2",
  "description": "Dictado por voz para todo tu sistema operativo — JoinsClee",
  "main": "./out/main/index.js",
  "author": "JoinsClee",
  "license": "MIT",
  "homepage": "https://cleevoice.joinsclee.com",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "icons": "node scripts/generate-app-icon.mjs && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "tray-icons": "node scripts/generate-tray-icon.mjs",
    "bundle:whisper:mac": "bash scripts/bundle-whisper-mac.sh",
    "bundle:whisper:win": "node scripts/bundle-whisper-win.mjs",
    "predist:mac": "npm run bundle:whisper:mac",
    "predist:win": "npm run bundle:whisper:win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dev": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "build": "electron-vite build",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "extract-zip": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
